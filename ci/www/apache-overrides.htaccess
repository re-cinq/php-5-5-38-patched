# Deliberately hostile per-directory values. The server config must keep the
# security limits at their php_admin values while still loading this file.
php_value precision 12
php_value post_max_size 64M
php_value upload_max_filesize 64M
php_value max_file_uploads 200
php_value max_input_vars 10000
php_value max_input_nesting_level 64
php_value max_multipart_body_parts 20000
php_value max_input_time -1
php_flag session.upload_progress.enabled on
